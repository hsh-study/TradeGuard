        { "refId": "A", "expr": "sum by (environment) (increase(tradeguard_kis_token_cache_count_total{application=\"tradeguard\",result=\"refresh\"}[$__rate_interval]))", "legendFormat": "refresh {{environment}}" },
        { "refId": "B", "expr": "sum by (environment, result) (increase(tradeguard_kis_token_issue_count_total{application=\"tradeguard\"}[$__rate_interval]))", "legendFormat": "issue {{environment}} {{result}}" }
