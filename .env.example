# MySQL JDBC 접속 URL입니다. 로컬 MySQL의 database 이름, 시간대, 문자 인코딩을 지정합니다.
DB_URL=jdbc:mysql://localhost:3306/tradeguard?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# TradeGuard가 MySQL에 접속할 때 사용할 사용자 이름입니다.
DB_USERNAME=tradeguard
# MySQL 접속 비밀번호입니다. 실제 값으로 변경하고 저장소에 커밋하지 마십시오.
DB_PASSWORD=change-me
# Hibernate의 스키마 처리 방식입니다. Flyway를 사용하므로 로컬 운영에서는 validate를 유지합니다.
JPA_DDL_AUTO=validate
# Hibernate가 사용할 DB dialect입니다. 로컬 운영 DB가 MySQL이므로 MySQLDialect를 사용합니다.
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# 실매매 기능 전체 허용 스위치입니다. 실제 주문을 사용하지 않을 때는 false로 유지합니다.
LIVE_TRADING_ENABLED=false
# KIS 주문 adapter 허용 스위치입니다. 실주문에는 LIVE_TRADING_ENABLED와 함께 true여야 합니다.
KIS_TRADING_ENABLED=false
# KIS 주문 환경입니다. REAL은 실전투자, DEMO는 모의투자입니다.
KIS_TRADING_ENVIRONMENT=REAL
# 주문에 사용할 KIS 계좌번호 앞 8자리입니다. 로그나 저장소에 노출하지 마십시오.
KIS_ACCOUNT_NUMBER=
# 주문 계좌의 상품코드입니다. 일반적인 종합계좌는 보통 01이지만 실제 계좌를 확인해야 합니다.
KIS_ACCOUNT_PRODUCT_CODE=
# 매수 체결금액에 적용할 수수료율입니다. 0.00015는 0.015%를 의미합니다.
LIVE_BUY_COMMISSION_RATE=0.00015
# 매도 체결금액에 적용할 수수료율입니다. 0.00015는 0.015%를 의미합니다.
LIVE_SELL_COMMISSION_RATE=0.00015
# 매도 체결금액에 적용할 세율입니다. 0.0020은 0.20%를 의미합니다.
LIVE_SELL_TAX_RATE=0.0020
# 자동매도 평가에서 허용할 최소 예상 순이익 금액입니다. 단위는 원입니다.
LIVE_MINIMUM_NET_PROFIT_AMOUNT=0
# 포지션 하나에서 허용할 최대 손실 금액입니다. 단위는 원입니다.
LIVE_MAX_LOSS_AMOUNT_PER_POSITION=30000
# 별도 가격대 정책이 없을 때 사용하는 기본 익절률입니다. 단위는 %입니다.
LIVE_DEFAULT_TAKE_PROFIT_RATE=5.0
# 별도 가격대 정책이 없을 때 사용하는 기본 손절률입니다. 단위는 %이며 음수로 설정합니다.
LIVE_DEFAULT_STOP_LOSS_RATE=-3.0
# 한 번의 실매매 주문에서 허용할 최대 주문금액입니다. 단위는 원입니다.
LIVE_MAX_ALLOWED_ORDER_AMOUNT=1000000
# 미체결 주문 자동취소 사용 여부입니다. 기본값 false에서는 수동 취소만 수행합니다.
LIVE_ORDER_AUTO_CANCEL_ENABLED=false
# 자동취소가 활성화된 경우 매수 주문이 만료되는 시간입니다. 단위는 분입니다.
LIVE_BUY_ORDER_EXPIRE_MINUTES=3
# 자동취소가 활성화된 경우 매도 주문이 만료되는 시간입니다. 단위는 분입니다.
LIVE_SELL_ORDER_EXPIRE_MINUTES=3
# 자동취소가 활성화된 경우 장 마감 몇 분 전부터 미체결 주문을 취소할지 지정합니다.
LIVE_CANCEL_BEFORE_MARKET_CLOSE_MINUTES=5

# 시세 조회용 KIS 환경입니다. REAL은 실전 서버, DEMO는 모의투자 서버를 사용합니다.
KIS_READ_ONLY_ENVIRONMENT=DEMO
# KIS Developers에서 발급받은 App Key입니다. 실제 값을 저장소에 커밋하지 마십시오.
KIS_APP_KEY=
# KIS Developers에서 발급받은 App Secret입니다. 실제 값을 저장소에 커밋하지 마십시오.
KIS_APP_SECRET=
# 현재 애플리케이션에서 사용하지 않는 이전 호환용 계좌번호 항목입니다.
KIS_ACCOUNT_NO=
# access token 만료 몇 초 전부터 갱신 대상으로 판단할지 지정합니다.
KIS_TOKEN_REFRESH_BEFORE_SECONDS=600
# 날짜가 바뀌면 아직 유효한 token도 하루 한 번 새로 발급할지 지정합니다.
KIS_TOKEN_DAILY_REFRESH_ENABLED=true
# 일일 token 갱신 scheduler 실행 시각입니다. Asia/Seoul 기준 HH:mm 형식입니다.
KIS_TOKEN_ISSUE_TIME_KST=07:30
# token cache 방식입니다. MEMORY는 재시작 시 소멸하고 DB는 암호화해 MySQL에 보존합니다.
KIS_TOKEN_CACHE_MODE=MEMORY
# DB cache 모드에서 token을 AES-256-GCM으로 암호화할 Base64 인코딩 32바이트 key입니다.
KIS_TOKEN_ENCRYPTION_KEY=
# token 갱신 lock을 비정상 종료로 남은 lock으로 판단하는 제한시간입니다. 단위는 초입니다.
KIS_TOKEN_REFRESH_LOCK_TIMEOUT_SECONDS=120
# 다른 갱신 작업이 진행 중일 때 token 저장 완료를 기다릴 최대 시간입니다. 단위는 초입니다.
KIS_TOKEN_REFRESH_LOCK_WAIT_SECONDS=10
# 테스트에서만 KIS API base URL을 대체하는 값입니다. 일반 로컬 운영에서는 비워 둡니다.
KIS_BASE_URL_OVERRIDE=
# 시장 순위와 현재가 snapshot provider입니다. fake 또는 kis를 지정합니다.
MARKET_DATA_REALTIME_PROVIDER=fake
# 장중 분봉 provider입니다. fake 또는 kis를 지정하며 KIS는 당일 분봉만 조회합니다.
MARKET_DATA_INTRADAY_PROVIDER=fake
# 전일 시간외 데이터 provider입니다. fake, kis, disabled 중 하나를 지정합니다.
AFTER_HOURS_DATA_PROVIDER=fake
# 이전 설정 호환용입니다. AFTER_HOURS_DATA_PROVIDER가 비어 있을 때만 사용됩니다.
AFTER_HOURS_DATA_ENABLED=true
# KIS 읽기 전용 smoke test 실행 여부입니다. 명시적으로 true일 때만 외부 조회를 수행합니다.
KIS_SMOKE_TEST_ENABLED=false
# KIS 주문 smoke test 실행 여부입니다. DEMO 환경에서 실제 모의 주문을 제출하므로 기본 false입니다.
KIS_LIVE_ORDER_SMOKE_TEST_ENABLED=false
# 주문 smoke test에서 사용할 6자리 종목코드입니다.
KIS_LIVE_ORDER_SMOKE_TEST_STOCK_CODE=
# 주문 smoke test에서 사용할 지정가입니다. 시장가 주문은 지원하지 않습니다.
KIS_LIVE_ORDER_SMOKE_TEST_PRICE=
# calendar DB에 데이터가 없을 때 휴장일로 처리할 날짜 목록입니다. ISO 날짜를 쉼표로 구분합니다.
MARKET_CALENDAR_HOLIDAYS=
# 검증된 KRX calendar JSON endpoint입니다. 연도 치환이 필요하면 URL에 {year}를 포함합니다.
MARKET_CALENDAR_KRX_ENDPOINT=

# 관심종목과 전략 후보의 일봉·기술지표 자동 보강 사용 여부입니다.
INDICATOR_WARMUP_ENABLED=true
# warmup 시 확보할 완료된 최근 거래일 수입니다.
INDICATOR_WARMUP_LOOKBACK_TRADING_DAYS=120
# MA60 데이터 충분 여부를 판단할 최소 일봉 수입니다.
INDICATOR_WARMUP_MIN_REQUIRED_DAYS_FOR_MA60=60
# true이면 MA60 데이터가 부족한 종목을 전략 후보에서 제외합니다.
INDICATOR_WARMUP_FAIL_STRATEGY_WHEN_INSUFFICIENT=false
# 한 번의 후보 warmup에서 처리할 최대 종목 수입니다.
INDICATOR_WARMUP_MAX_SYMBOLS_PER_RUN=100

# Discord 알림 Webhook URL입니다. 비어 있으면 알림 전송을 건너뛰며 실제 값을 커밋하지 마십시오.
DISCORD_WEBHOOK_URL=
