DB_URL=jdbc:mysql://localhost:3306/tradeguard?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=tradeguard
DB_PASSWORD=change-me
JPA_DDL_AUTO=validate
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# Live orders require both switches and valid account settings.
LIVE_TRADING_ENABLED=false
KIS_TRADING_ENABLED=false
KIS_TRADING_ENVIRONMENT=REAL
KIS_TRADING_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT_CODE=
LIVE_BUY_COMMISSION_RATE=0.00015
LIVE_SELL_COMMISSION_RATE=0.00015
LIVE_SELL_TAX_RATE=0.0020
LIVE_MINIMUM_NET_PROFIT_AMOUNT=0
LIVE_MAX_LOSS_AMOUNT_PER_POSITION=30000
LIVE_DEFAULT_TAKE_PROFIT_RATE=5.0
LIVE_DEFAULT_STOP_LOSS_RATE=-3.0
LIVE_MAX_ALLOWED_ORDER_AMOUNT=1000000
LIVE_ORDER_AUTO_CANCEL_ENABLED=false
LIVE_BUY_ORDER_EXPIRE_MINUTES=3
LIVE_SELL_ORDER_EXPIRE_MINUTES=3
LIVE_CANCEL_BEFORE_MARKET_CLOSE_MINUTES=5

# Do not commit real values.
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
MARKET_DATA_REALTIME_PROVIDER=fake
MARKET_DATA_INTRADAY_PROVIDER=fake
AFTER_HOURS_DATA_PROVIDER=fake
# Deprecated compatibility switch. Used only when provider is blank.
AFTER_HOURS_DATA_ENABLED=true
# Test process opt-in only. Smoke tests remain disabled by default.
KIS_SMOKE_TEST_ENABLED=false
# KIS order smoke test is DEMO-only and submits an actual virtual order.
KIS_LIVE_ORDER_SMOKE_TEST_ENABLED=false
KIS_LIVE_ORDER_SMOKE_TEST_STOCK_CODE=
KIS_LIVE_ORDER_SMOKE_TEST_PRICE=
# Comma-separated ISO dates, for example 2026-01-01,2026-02-17.
MARKET_CALENDAR_HOLIDAYS=
MARKET_CALENDAR_KRX_ENDPOINT=

# Optional. If empty, Discord notifications are skipped.
DISCORD_WEBHOOK_URL=
